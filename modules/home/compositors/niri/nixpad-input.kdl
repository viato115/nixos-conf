input {
    keyboard {
        xkb {
            layout "de"
        }
        numlock
    }

    touchpad {
        tap
        dwt
        click-method "clickfinger"
        scroll-factor 0.5
        accel-profile "flat"
        accel-speed 0.3
    }

    mouse {
        accel-profile "flat"
    }

    trackpoint {
        accel-profile "flat"
    }

    tablet {
        map-to-output "eDP-1"
    }

    touch {
        map-to-output "eDP-1"
    }
}

output "eDP-1" {
    scale 1
}
